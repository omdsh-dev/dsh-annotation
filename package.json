{
  "name": "@dsh-external/dsh-annotation",
  "version": "1.3.13",
  "type": "module",
  "description": "DSH Web 选中批注插件：选中助手回复 → 批注（可留空）→ 输入框旁「批注 ×N」标签 → 回车随消息发送；用户气泡隐藏批注块（零闪烁），模型按「Annotation N：」逐条回应，回复标签可悬浮查看批注原文",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check index.mjs && node --check client.js",
    "prepublishOnly": "npm run check"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omdsh-dev/dsh-annotation.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
